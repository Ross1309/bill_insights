{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "netlify-dev",
      "runtimeExecutable": "netlify",
      "runtimeArgs": [
        "dev",
        "--no-open"
      ],
      "port": 8888
    },
    {
      "name": "mockups",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--bind",
        "127.0.0.1",
        "--directory",
        "mockups"
      ],
      "port": 8765
    },
    {
      "name": "functions-only",
      "runtimeExecutable": "netlify",
      "runtimeArgs": [
        "functions:serve",
        "--port",
        "9990"
      ],
      "port": 9990
    }
  ]
}
